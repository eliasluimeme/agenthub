# Where the SQLite database lives (default: ./data/agenthub.db). Use :memory: for tests.
AGENTHUB_DB=./data/agenthub.db

# Encrypts agent model API keys at rest. Set a long random value in production.
AGENTHUB_SECRET=change-me

# Password for the seeded demo account (demo@agenthub.dev). Default is in the README.
# AGENTHUB_DEMO_PASSWORD=
# Set to 1 to start with an empty database instead of demo data.
# AGENTHUB_NO_SEED=1

# 1 lets agents with their own key call model providers (Anthropic, OpenAI, Mistral, Google).
# Without it, runs are simulated and labelled as such.
AGENTHUB_LIVE_MODELS=0

# In-process heartbeat scheduler (every 5 minutes). Set to 0 when using the cron route instead.
AGENTHUB_SCHEDULER=1
# Secret for POST /api/cron/heartbeat (Authorization: Bearer ...).
# CRON_SECRET=

# 0 disables the test-mode "Add credits" button.
AGENTHUB_ALLOW_TOPUP=1
